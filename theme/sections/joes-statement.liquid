<section class="joes-statement">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.body }}</p>
</section>

{% schema %}
{
  "name": "Joe's statement",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Designed oddly. Printed on demand." },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "No warehouse, no leftover stock. Every tee, mug and tote is printed the moment you order it — which is why each one feels a little too specific. That's the point."
    }
  ],
  "presets": [{ "name": "Joe's statement" }]
}
{% endschema %}
