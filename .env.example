# Copy to .env and fill in. NEVER commit .env.
# Everything is read through config.py.

# --- Anthropic (ideation) ---
ANTHROPIC_API_KEY=
IDEATION_MODEL=claude-sonnet-5

# --- Printify (upload + publish to Etsy) ---
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# Blueprint / print-provider / variant ids for the tee you sell.
# Discover with: python -m pod_autopilot.printify_client --catalog
#                python -m pod_autopilot.printify_client --blueprint <id>
PRINTIFY_BLUEPRINT_ID=
PRINTIFY_PRINT_PROVIDER_ID=

# --- Image generation (design.py) ---
# design.py is a stub; provider key goes here once implemented.
IMAGE_PROVIDER=
IMAGE_API_KEY=

# --- Trend proxy ---
# "google" (pytrends) or "csv"
TREND_SOURCE=google
TREND_CSV_PATH=

# --- Behaviour ---
# MOCK=1 forces fully offline deterministic fakes (no network, no spend).
MOCK=0
# Directory where per-design artifacts (art, copy, mockups) are written.
OUTPUT_DIR=output
# Minimum acceptable profit margin (fraction, e.g. 0.35 = 35%) before publishing.
MIN_MARGIN=0.35
# Retail price (USD) applied to created listings.
RETAIL_PRICE=24.99
