# Core (required for the daily pipeline)
ANTHROPIC_API_KEY=
PRINTIFY_API_KEY=
REPLICATE_API_TOKEN=

# Store (revenue lookups, analytics, publish target)
SHOPIFY_STORE=yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=

# Behavior
APPROVAL_MODE=review            # "review" stages to runs/; "auto" publishes
MAX_PUBLISHES_PER_DAY=5
GRACE_BUDGET_USD=30             # max monthly loss during cold start
SPEND_RATIO=0.25                # spend <= 25% of MTD revenue + grace

# Optional — Pinterest traffic agent (skipped if unset)
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# Optional — support agent + weekly digest (skipped if unset)
SUPPORT_IMAP_HOST=
SUPPORT_SMTP_HOST=
SUPPORT_EMAIL=
SUPPORT_EMAIL_PASSWORD=
OWNER_EMAIL=

# Optional — trademark phrase search endpoint (USPTO has no free public one;
# leave unset and the Claude IP gate screens from its own knowledge)
USPTO_SEARCH_URL=
