# Copy to .env and fill in. NEVER commit .env.
# Everything is read through config.py.

# --- Anthropic (ideation) ---
ANTHROPIC_API_KEY=
IDEATION_MODEL=claude-sonnet-5

# --- Printify (upload + publish to Etsy) ---
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# Blueprint / print-provider / variant ids for the tee you sell.
# Discover with: python -m pod_autopilot.printify_client --catalog
#                python -m pod_autopilot.printify_client --blueprint <id>
PRINTIFY_BLUEPRINT_ID=
PRINTIFY_PRINT_PROVIDER_ID=

# --- Image generation (design.py) ---
# Provider for design.py. Currently supported: "recraft".
# Leave IMAGE_PROVIDER empty to keep design.py stubbed (only MOCK=1 works then).
IMAGE_PROVIDER=recraft
IMAGE_API_KEY=
# Recraft knobs (defaults are fine for POD tees). Endpoint:
#   https://external.api.recraft.ai/v1/images/generations
RECRAFT_MODEL=recraftv3
RECRAFT_STYLE=vector_illustration
RECRAFT_SIZE=1024x1024

# --- Trend proxy ---
# "google" (pytrends) or "csv"
TREND_SOURCE=google
TREND_CSV_PATH=

# --- Screening / USPTO live-mark check (optional, disabled unless URL set) ---
# There is no stable free USPTO phrase-search JSON API, so this is a pluggable
# hook. Leave USPTO_SEARCH_URL empty to rely on the local blocklist + fuzzy
# matcher only. If set, the check fails CLOSED on a match, OPEN on any error.
USPTO_SEARCH_URL=
USPTO_API_KEY=

# --- Behaviour ---
# MOCK=1 forces fully offline deterministic fakes (no network, no spend).
MOCK=0
# Directory where per-design artifacts (art, copy, mockups) are written.
OUTPUT_DIR=output
# Minimum acceptable profit margin (fraction, e.g. 0.35 = 35%) before publishing.
MIN_MARGIN=0.35
# Retail price (USD) applied to created listings.
RETAIL_PRICE=24.99
